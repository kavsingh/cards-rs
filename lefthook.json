{
	"$schema": "https://raw.githubusercontent.com/evilmartians/lefthook/refs/tags/v2.1.10/schema.json",
	"min_version": "2.1.10",
	"pre-commit": {
		"jobs": [
			{ "glob": "*.rs", "run": "cargo xtask format", "stage_fixed": true }
		]
	},
	"pre-push": {
		"parallel": true,
		"jobs": [{ "run": "cargo xtask lint" }, { "run": "cargo xtask test" }]
	}
}
